# Use your actual project settings. Never put a real credential in this file.
# Use a restricted private PostgreSQL login for runtime (Supabase pooler on Vercel).
DATABASE_URL=
# Optional separate privileged connection for migrations and first-admin bootstrap.
MIGRATION_DATABASE_URL=

# Required for production on Vercel. Exact canonical origin (for example https://esports.example.org).
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Older Supabase projects can supply an anon key instead of a publishable key.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only; used for the private Storage bucket. Prefer a separately managed secret.
SUPABASE_SERVICE_ROLE_KEY=
# Set to supabase on hosted deployments. Local loopback PostgreSQL can use local testing auth.
RJNX_AUTH_MODE=
# Only set to 1 if your private reverse proxy overwrites X-Real-IP.
TRUST_PROXY=0
# Optional, after applying supabase/realtime.sql and enabling private Broadcast.
RJNX_REALTIME_ENABLED=0
